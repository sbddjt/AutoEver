# --- 1. 데이터 저장 및 조회 ---

# 1개 저장 (SET)
SET a adam
# -> OK

# 1개 조회 (GET)
GET a
# -> "adam" (대소문자 구별, 없으면 (nil))

# 삭제 (DEL)
DEL a
# -> (integer) 1

# 여러 개 저장 (MSET)
MSET a adam b eve

# 여러 개 조회 (MGET)
MGET a b

# 키 조회 (KEYS)
# 주의: 운영 환경에서는 성능 저하 위험으로 사용 지양
KEYS * # 반복 조회 (SCAN)
# 커서 0부터 시작, 모든 패턴(*), 10개씩 조회
SCAN 0 MATCH * COUNT 10


# --- 2. 유효 기간 설정 (TTL) ---

# 데이터 저장
SET c lee

# 30초 후 만료 설정
EXPIRE c 30

# 남은 시간 확인
TTL c
